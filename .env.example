# YouTube to Ebook - Environment Variables
# Copy this file to .env and fill in your keys

# YouTube Data API Key (free from Google Cloud Console)
# Get it at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supadata API Key (for fetching video transcripts)
# Get it at: https://supadata.ai
SUPADATA_API_KEY=your_supadata_api_key_here

# Article writing model (switchable provider, OpenAI-compatible protocol)
# ARTICLE_PROVIDER: deepseek (default) or glm
ARTICLE_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com)
# Models: deepseek-chat (V3) / deepseek-reasoner (R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# GLM fallback (Z.ai Coding Plan key, https://z.ai/manage-apikey/apikey-list)
# Used automatically when DeepSeek fails (e.g. out of quota)
GLM_API_KEY=your_zai_api_key_here
GLM_MODEL=glm-4.5-air

# Email delivery switch:
# false = skip email, only save EPUB + HTML to newsletters/
# true  = send via Gmail (fill in the Gmail settings below)
SEND_EMAIL=true

# Gmail credentials (only needed when SEND_EMAIL=true)
# Create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
